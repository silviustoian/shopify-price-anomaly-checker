generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

model Scan {
  id              String      @id @default(cuid())
  shopDomain      String
  productsScanned Int
  variantsScanned Int
  issuesFound     Int
  criticalCount   Int
  warningCount    Int
  infoCount       Int
  createdAt       DateTime    @default(now())

  issues          ScanIssue[]

  @@index([createdAt])
}

model ScanIssue {
  id               String        @id @default(cuid())
  scanId           String
  shopifyProductId String
  shopifyVariantId String
  productTitle     String
  variantTitle     String
  sku              String?
  price            Decimal?
  compareAtPrice   Decimal?
  issueType        String
  severity         IssueSeverity
  recommendation   String
  createdAt        DateTime      @default(now())

  scan             Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([severity])
  @@index([issueType])
}